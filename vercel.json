{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "feature/lilly-calendar": true,
      "main": false
    }
  },
  "crons": [
    {
      "path": "/api/tasks/notifications/process",
