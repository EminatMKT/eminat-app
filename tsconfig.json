{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@e2e/*": [
        "./e2e/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-local-review/types/**/*.ts",
    ".next-hardening-build/types/**/*.ts",
    ".next-hardening-build/dev/types/**/*.ts",
    ".next-hardening-dev/types/**/*.ts",
    ".next-hardening-dev/dev/types/**/*.ts",
    ".next-release-verify/types/**/*.ts",
    ".next-release-verify/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "rules",
    "scripts/agent-guard"
  ]
}
