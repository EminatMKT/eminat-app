{
  "name": "eminat-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack",
    "build:check": "NEXT_BUILD_DIR=.next-verify next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "test": "TZ=America/Guayaquil vitest run",
    "test:watch": "TZ=America/Guayaquil vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "postinstall": "playwright install chromium",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "rules:check": "sh .githooks/centinela.sh --self-check",
    "rules:contexto": "sh .githooks/centinela.sh --contexto-al-dia",
    "rules:sweep": "sh .githooks/centinela.sh --sweep",
    "db:rls": "sh supabase/checks/rls.sh",
    "db:migraciones-fresca": "sh supabase/checks/migraciones-base-fresca.sh",
    "db:columna-borrada": "perl supabase/checks/columna-borrada-en-trigger.pl supabase/migrations/*.sql",
    "lint:css": "stylelint \"src/**/*.css\"",
    "guard:test": "bun test ./scripts/agent-guard/core/decide.checks.ts ./scripts/agent-guard/adapters/adapters.checks.ts ./scripts/agent-guard/adapters/failures.checks.ts ./scripts/agent-guard/adapters/changed.checks.ts ./scripts/agent-guard/generate/settings.checks.ts ./scripts/agent-guard/generate/execpolicy.checks.ts ./scripts/agent-guard/generate/drift.checks.ts ./scripts/agent-guard/generate/hook-command.checks.ts",
    "guard:typecheck": "tsc -p scripts/agent-guard",
    "guard:generate": "bun scripts/agent-guard/generate/main.ts --write",
    "guard:check": "bun scripts/agent-guard/generate/main.ts --check && pnpm guard:test && pnpm guard:typecheck"
  },
  "dependencies": {
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "@react-email/components": "^1.0.12",
    "@splinetool/react-spline": "^2.2.6",
    "@splinetool/runtime": "^0.9.526",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.383.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.11.0",
    "resend": "^6.39.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "autoprefixer": "^10.7.0",
    "bun": "1.4.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.33",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "supabase": "^2.122.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
