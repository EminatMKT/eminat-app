{
  "name": "eminat-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "NEXT_BUILD_DIR=.next-verify next build",
    "start": "next start",
    "lint": "next lint",
    "test": "TZ=America/Guayaquil vitest run",
    "test:watch": "TZ=America/Guayaquil vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "rules:check": "sh .githooks/centinela.sh --self-check --semilla",
    "rules:contexto": "sh .githooks/centinela.sh --contexto-al-dia",
    "rules:barrido": "sh .githooks/centinela.sh --barrido",
    "db:rls": "sh supabase/checks/rls.sh",
    "lint:css": "stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "@lottiefiles/react-lottie-player": "^3.5.3",
    "@react-email/components": "^1.0.12",
    "@splinetool/react-spline": "^2.2.6",
    "@splinetool/runtime": "^0.9.506",
    "@supabase/ssr": "^0.3.0",
    "@supabase/supabase-js": "^2.43.4",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.383.0",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.2.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "supabase": "^2.106.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
