+import {readFamilyExpansion,type FamilyExpansionData} from './expansion-data';
+import {FamilyExpansionControls} from './expansion-controls';
+export async function FamilyExpansion({locale}:{locale:PortalLocale}){
+ const t=(es:string,en:string)=>locale==='en'?en:es;let data:FamilyExpansionData|null=null;
+ try{data=await readFamilyExpansion();}catch{/* Do not replace a failed scoped read with mock coverage. */}
+ if(!data)return <Card><p role="alert">{t('No pudimos consultar las plazas adicionales. Tu cobertura actual no cambia.','We could not load additional places. Your current coverage is unchanged.')}</p></Card>;
+ const current=data.current;
+ const pay=data.eligible&&current?.status==='PAYMENT_PENDING'&&current.invoiceStatus==='OPEN'&&current.hostedUrl&&/^https:\/\/connect\.intuit\.com\/t\/[^\s]+$/.test(current.hostedUrl);
+ return <div id="additional-family-members"><Card><SectionTitle title={t('Familiares adicionales','Additional family members')}/>
+  <p>{t('El plan Familiar incluye tres personas. Se permiten hasta nueve adicionales, con aprobación del equipo antes de la factura y activación solo después del pago verificado.','The Family plan includes three people. Up to nine additional people require staff approval before invoicing and activate only after verified payment.')}</p>
+  <p>{t('Código familiar','Family code')}: {data.code??'—'} · {t('Plan','Plan')}: {data.plan??'—'} · {t('Vigente hasta','Valid through')}: {data.expiresAt??'—'}</p>
+  <p>{t('Incluidos en el plan base','Included in the base plan')}: 3 · {t('Adicionales activos pagados','Active paid additional members')}: {data.paidAdditionalPeople} · {t('Personas activas','Active people')}: {data.activePeople}</p>
+  <p>{t('Precio mensual por persona adicional','Monthly price per additional person')}: {formatCents(data.monthlyCents)}. {t('La factura nueva cubre únicamente el período restante y no modifica la factura original.','The new invoice covers only the remaining term and does not modify the original invoice.')}</p>
+  {data.quoteBreakdown&&<p>{t("Meses restantes (fracción exacta)","Remaining months (exact fraction)")}: {data.quoteBreakdown} × {formatCents(data.monthlyCents)} = {formatCents(data.perMemberCents)} {t("por persona","per person")}</p>}
+  {data.eligible?<FamilyExpansionControls locale={locale} max={data.availableAdditionalPlaces} current={current} unitCents={current?.perMemberCents??data.perMemberCents} existingPeople={data.activePeople} idempotencyKey={randomUUID()}/>:<p>{data.includedPlacesAvailable>0?t('Completa primero las plazas incluidas mediante la solicitud de familiar.','Fill the included places first using the family-member request.'):t('No hay plazas adicionales disponibles para esta membresía en este momento.','Additional places are not available for this membership right now.')}</p>}
+  {current&&<><p>{t('Factura','Invoice')}: {current.invoiceNumber??t('Sin emitir','Not issued')} · {t('Importe','Amount')}: {formatCents(current.amountCents)}</p>
+   <p>{current.completedAt?t('Pago verificado y familiares activados.','Payment verified and family members activated.'):current.approvalReady?t('Aprobación completa. La cobertura sigue pendiente del pago verificado.','Approval complete. Coverage still awaits verified payment.'):t('Preparación o aprobación del equipo pendiente. Nadie ha sido activado por esta solicitud.','Family details or staff approval are pending. This request has not activated anyone.')}</p>
+   {pay&&<a className="button button-primary" href={current.hostedUrl!} target="_blank" rel="noopener noreferrer">{t('Pagar familiares en QuickBooks','Pay for family members in QuickBooks')}</a>}
+  </>}
+ </Card>{current&&!current.completedAt&&<Card><FamilyDraftManager primaryName="" members={current.members} locked={!!current.jobState||!!current.invoiceNumber} additionalMembers={current.count} additionalOnly locale={locale}/></Card>}</div>;
+}
