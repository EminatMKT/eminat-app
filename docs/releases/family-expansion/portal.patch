@@ -0,0 +1,16 @@
+import {describe,it,expect} from 'vitest';
+import {familyPurchaseBreakdown} from './family-pricing';
+describe('Family purchase display quote',()=>{
+  for(const count of [0,1,2,3,5,9]) for(const months of [2,3,6,12]) for(const rate of [4999,6999,8999])
+    it(`${count} additional people at ${rate} for ${months} months`,()=>{
+      const q=familyPurchaseBreakdown(8999*months,rate,months,count);
+      expect(q.totalPeople).toBe(3+count);expect(q.additionalCents).toBe(rate*months*count);
+      expect(q.totalCents).toBe((8999+rate*count)*months);
+    });
+  it('keeps the initial monthly advance but adds no surcharge to the additional-member rate',()=>{
+    expect(familyPurchaseBreakdown(19998,4999,2,2)).toMatchObject({memberTermCents:9998,additionalCents:19996,totalCents:39994});
+  });
+  for(const count of [-1,10,1.5,NaN,Infinity])it(`rejects invalid count ${count}`,()=>{
+    expect(()=>familyPurchaseBreakdown(19998,4999,2,count)).toThrow('INVALID_FAMILY_QUOTE');
+  });
+});
diff --git a/src/lib/family-pricing.ts b/src/lib/family-pricing.ts
new file mode 100644
index 0000000..36a9545
--- /dev/null
+++ b/src/lib/family-pricing.ts
@@ -0,0 +1,12 @@
+/** Display-only calculation from the server catalog. The API re-quotes every request. */
+export function familyPurchaseBreakdown(baseCents:number,monthlyMemberCents:number,months:number,additionalMembers:number) {
+  if (![baseCents,monthlyMemberCents,months,additionalMembers].every(Number.isSafeInteger)
+    || baseCents<0 || monthlyMemberCents<=0 || months<1 || months>12 || additionalMembers<0 || additionalMembers>9)
+    throw new Error('INVALID_FAMILY_QUOTE');
+  const memberTermCents=monthlyMemberCents*months;
+  const additionalCents=memberTermCents*additionalMembers;
+  const totalCents=baseCents+additionalCents;
+  if (!Number.isSafeInteger(totalCents)) throw new Error('INVALID_FAMILY_QUOTE');
+  return {includedMembers:3,additionalMembers,totalPeople:3+additionalMembers,baseCents,
+    monthlyMemberCents,months,memberTermCents,additionalCents,totalCents};
+}
