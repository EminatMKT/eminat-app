@@ -0,0 +1,30 @@
+import 'server-only';
+import {lillyPatientRequest} from '@/lib/api/lilly';
+import type {FamilyDraftMember} from '@/components/family-draft-manager';
+export type FamilyAdditionState={
+  id:string;status:string;count:number;amountCents:number;perMemberCents:number;quoteDate:string;quoteExpired:boolean;
+  invoiceNumber:string|null;invoiceStatus:string;paymentStatus:string;hostedUrl:string|null;jobState:string|null;
+  approvalReady:boolean;agreementSatisfied:boolean;completedAt:string|null;members:FamilyDraftMember[];
+};
+export type FamilyExpansionData={
+  eligible:boolean;reason:string|null;membershipId:string|null;code:string|null;plan:string|null;expiresAt:string|null;
+  activePeople:number;paidAdditionalPeople:number;availableAdditionalPlaces:number;includedPlacesAvailable:number;
+  monthlyCents:number;perMemberCents:number;quoteDate:string|null;quoteBreakdown:string;
+  current:FamilyAdditionState|null;
+};
+const record=(value:unknown):value is Record<string,unknown>=>!!value&&typeof value==='object'&&!Array.isArray(value);
+const number=(value:unknown)=>Number.isSafeInteger(value)&&Number(value)>=0;
+export async function readFamilyExpansion():Promise<FamilyExpansionData>{
+ const response=await lillyPatientRequest('familyaddition',{authenticated:true});
+ const data=response.data;
+ if(!record(data)||typeof data.eligible!=='boolean'||!number(data.activePeople)||!number(data.paidAdditionalPeople)
+   ||!number(data.availableAdditionalPlaces)||Number(data.availableAdditionalPlaces)>9||!number(data.includedPlacesAvailable)
+   ||!number(data.monthlyCents)||!number(data.perMemberCents)||typeof data.quoteBreakdown!=='string')throw new Error('FAMILY_EXPANSION_UNAVAILABLE');
+ if(data.current!==null){
+  const current=data.current;
+  if(!record(current)||typeof current.id!=='string'||typeof current.status!=='string'||!number(current.count)||Number(current.count)>9
+    ||!number(current.amountCents)||!number(current.perMemberCents)||typeof current.approvalReady!=='boolean'
+    ||typeof current.agreementSatisfied!=='boolean'||typeof current.quoteExpired!=='boolean'||!Array.isArray(current.members))throw new Error('FAMILY_EXPANSION_UNAVAILABLE');
+ }
+ return data as unknown as FamilyExpansionData;
+}
