+ expect(minus.hasAttribute('disabled')).toBe(true);
+ for(let n=0;n<9;n++)fireEvent.click(plus);
+ expect(plus.hasAttribute('disabled')).toBe(true);
+ expect(screen.getByText('$224.97')).toBeTruthy();
+ expect(screen.getByText(locale==='en'?/Total after payment: 12/:/Total después del pago: 12/)).toBeTruthy();
+ for(let n=0;n<9;n++)fireEvent.click(minus);
+ expect(minus.hasAttribute('disabled')).toBe(true);
