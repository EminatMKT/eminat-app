+'use client';
+import {useActionState,useState} from 'react';
+import type {PortalLocale} from '@/lib/portal-locale';
+import {formatCents} from '@/lib/format-cents';
+import {familyExpansionAction} from './expansion-actions';
+import type {FamilyAdditionState} from './expansion-data';
+export function FamilyExpansionControls({locale,max,current,unitCents,existingPeople,idempotencyKey}:{locale:PortalLocale;max:number;current:FamilyAdditionState|null;unitCents:number;existingPeople:number;idempotencyKey:string}){
+ const t=(es:string,en:string)=>locale==='en'?en:es;
+ const [count,setCount]=useState(current?.count??0),[state,action,pending]=useActionState(familyExpansionAction,{message:''});
+ const locked=!!current?.jobState||!!current?.invoiceNumber;
+ return <><form action={action} className="login-form">
+  <input type="hidden" name="operation" value={current?'UPDATE':'CREATE'}/><input type="hidden" name="count" value={count}/><input type="hidden" name="idempotencyKey" value={idempotencyKey}/>{current&&<input type="hidden" name="intentId" value={current.id}/>}
+  <div className="selection-actions" role="group" aria-label={t('Nuevos familiares adicionales','New additional family members')}>
+   <button type="button" className="button button-white" disabled={count===0||pending||locked} aria-label={t('Quitar una plaza adicional','Remove one additional place')} onClick={()=>setCount(n=>Math.max(0,n-1))}>−</button>
+   <output aria-live="polite" aria-label={t('Nuevos miembros','New members')}>{count}</output>
+   <button type="button" className="button button-white" disabled={count>=max||pending||locked} aria-label={t('Agregar una plaza adicional','Add one additional place')} onClick={()=>setCount(n=>Math.min(max,n+1))}>+</button>
+  </div>
+  <p aria-live="polite">{t('Personas actuales','Current people')}: {existingPeople} · {t('Nuevos miembros','New members')}: {count} · {t('Total después del pago','Total after payment')}: {existingPeople+count}</p>
+  <p>{t('Importe prorrateado por persona','Prorated price per person')}: {formatCents(unitCents)} · {t('Total de esta factura adicional','Total for this additional invoice')}: <strong>{formatCents(unitCents*count)}</strong></p>
+  {!locked&&<button type="submit" className="button button-primary" disabled={pending||count===0||count>max||count===current?.count}>{t('Guardar plazas y preparar familiares','Save places and add family details')}</button>}
+ </form>
+ {current&&!locked&&<form action={action}><input type="hidden" name="idempotencyKey" value={idempotencyKey}/>{current&&<input type="hidden" name="intentId" value={current.id}/>}<input type="hidden" name="operation" value={current.quoteExpired?'REFRESH':'CANCEL'}/><button className="button button-white" disabled={pending}>{current.quoteExpired?t('Actualizar cotización','Refresh quote'):t('Cancelar solicitud adicional','Cancel additional-member request')}</button></form>}
+ {current&&<form action={action} className="agreement-acceptance"><input type="hidden" name="idempotencyKey" value={idempotencyKey}/>{current&&<input type="hidden" name="intentId" value={current.id}/>}<input type="hidden" name="operation" value="INVOICE"/>
+  {!current.agreementSatisfied&&<label className="agreement-checkbox"><input name="accepted" value="yes" type="checkbox" required/> {t('He leído y acepto el acuerdo vigente para estos familiares.','I have read and accept the current agreement for these family members.')} <a className="text-action" href={`/acuerdo/${locale}`} target="_blank" rel="noopener noreferrer">{t('Leer acuerdo','Read agreement')}</a></label>}
+  {!current.invoiceNumber&&<button className="button button-primary" disabled={pending||!current.approvalReady||current.quoteExpired}>{locked?t('Consultar factura en proceso','Check invoice in progress'):t('Solicitar factura de familiares','Request family-member invoice')}</button>}
+ </form>}
+ {state.message&&<p role="status" className="inline-note">{state.message}</p>}</>;
+}
