@@ -0,0 +1,37 @@
+'use server';
+import {createHash} from 'node:crypto';
+import {revalidatePath} from 'next/cache';
+import {requirePortalOrigin} from '@/lib/auth/origin';
+import {getPortalLocale} from '@/lib/portal-locale';
+import {lillyPatientRequest} from '@/lib/api/lilly';
+import {readFamilyExpansion} from './expansion-data';
+export async function familyExpansionAction(_state:{message:string},form:FormData){
+ await requirePortalOrigin();const locale=await getPortalLocale();const t=(es:string,en:string)=>locale==='en'?en:es;
+ try{
+  const current=await readFamilyExpansion(),operation=form.get('operation');
+  const formKey=form.get('idempotencyKey');
+  if(typeof formKey!=='string'||!/^[0-9a-f-]{36}$/i.test(formKey)||!current.membershipId)throw new Error('INVALID_REQUEST');
+  const digest=createHash('sha256').update(`${formKey}:${operation}:${form.get('count')??current.current?.count??''}`).digest('hex');
+  const key=`${digest.slice(0,8)}-${digest.slice(8,12)}-4${digest.slice(13,16)}-a${digest.slice(17,20)}-${digest.slice(20,32)}`;
+  if(operation!=='CREATE'&&(!current.current||form.get('intentId')!==current.current.id))throw new Error('FAMILY_ADDITION_CHANGED');
+  if(operation==='CREATE'||operation==='UPDATE'){
+   const count=Number(form.get('count'));
+   if(!Number.isSafeInteger(count)||count<1||count>current.availableAdditionalPlaces||!current.eligible)
+    return {message:t('Selecciona una cantidad disponible entre 1 y 9.','Choose an available quantity from 1 to 9.')};
+   await lillyPatientRequest('familyaddition',{authenticated:true,method:'POST',body:{action:operation,membershipId:current.membershipId,...(operation==='UPDATE'?{intentId:current.current!.id}:{}),count,idempotencyKey:key}});
+  }else if(operation==='REFRESH'||operation==='CANCEL'){
+   if(!current.current)return {message:t('Actualiza el estado antes de continuar.','Refresh the status before continuing.')};
+   await lillyPatientRequest('familyaddition',{authenticated:true,method:'POST',body:{action:operation,membershipId:current.membershipId,intentId:current.current.id,count:current.current.count,idempotencyKey:key}});
+  }else if(operation==='INVOICE'){
+   const intent=current.current;
+   if(!intent||!intent.approvalReady||intent.quoteExpired)return {message:t('Completa los datos, la aprobación del equipo y la cotización actual antes de solicitar la factura.','Complete the details, staff approval and current quote before requesting an invoice.')};
+   if(!intent.agreementSatisfied){
+    if(form.get('accepted')!=='yes')return {message:t('Lee y acepta el acuerdo vigente para continuar.','Read and accept the current agreement to continue.')};
+    await lillyPatientRequest('agreement',{authenticated:true,method:'POST',body:{intentId:intent.id,language:locale,accepted:true}});
+   }
+   await lillyPatientRequest('invoice',{authenticated:true,method:'POST',body:{intentId:intent.id}});
+  }else return {message:t('Acción no válida.','Invalid action.')};
+  for(const path of ['/familia','/membresia','/pagos','/renovacion'])revalidatePath(path);
+  return {message:t('Solicitud actualizada. Nadie recibe cobertura adicional antes de verificar el pago.','Request updated. Additional coverage begins only after payment is verified.')};
+ }catch{return {message:t('No pudimos completar el cambio. Revisa la aprobación, la capacidad y el estado de la factura antes de reintentar. No se ha activado cobertura adicional.','We could not complete the change. Check approval, capacity and invoice status before retrying. No additional coverage has been activated.')}};
+}
