diff --git a/src/components/locale-switch.test.ts b/src/components/locale-switch.test.ts
new file mode 100644
index 0000000..b9a4e89
--- /dev/null
+++ b/src/components/locale-switch.test.ts
@@ -0,0 +1,23 @@
+// @vitest-environment jsdom
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { createElement } from "react";
+import { afterEach, expect, it, vi } from "vitest";
+import { LocaleSwitch } from "./locale-switch";
+const { refresh } = vi.hoisted(() => ({ refresh: vi.fn() }));
+vi.mock("next/navigation", () => ({ useRouter: () => ({ refresh }) }));
+afterEach(() => { cleanup(); refresh.mockClear(); });
+for (const locale of ["es", "en"] as const) it(`exposes accessible ${locale} selection and preserves the locale refresh`, () => {
+ render(createElement(LocaleSwitch, { locale }));
+ const es = screen.getByRole("button", { name: "Español" });
+ const en = screen.getByRole("button", { name: "English" });
+ expect(es.getAttribute("aria-pressed")).toBe(String(locale === "es"));
+ expect(en.getAttribute("aria-pressed")).toBe(String(locale === "en"));
+ expect(es.getAttribute("type")).toBe("button");
+ const cookie = vi.spyOn(document, "cookie", "set");
+ fireEvent.click(locale === "es" ? en : es);
+ const next = locale === "es" ? "en" : "es";
+ expect(cookie).toHaveBeenCalledWith(`cs_locale=${next}; Path=/; Max-Age=31536000; SameSite=Lax; Secure`);
+ expect(document.documentElement.lang).toBe(next);
+ expect(refresh).toHaveBeenCalledOnce();
+ cookie.mockRestore();
+});
