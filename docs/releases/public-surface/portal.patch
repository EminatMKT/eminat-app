diff --git a/src/app/login/public-surface.test.ts b/src/app/login/public-surface.test.ts
new file mode 100644
index 0000000..05a77be
--- /dev/null
+++ b/src/app/login/public-surface.test.ts
@@ -0,0 +1,25 @@
+import { describe, expect, it, vi } from "vitest";
+import { readFileSync } from "node:fs";
+
+vi.mock("@/lib/portal-locale", () => ({ getPortalLocale: vi.fn() }));
+import { getPortalLocale } from "@/lib/portal-locale";
+import { generateMetadata } from "./page";
+
+describe("public auth metadata and legal navigation", () => {
+  it.each(["es", "en"] as const)("uses the visible %s locale for metadata", async locale => {
+    vi.mocked(getPortalLocale).mockResolvedValue(locale);
+    const metadata = await generateMetadata();
+    expect(metadata.title).toContain(locale === "en" ? "Member Portal" : "Portal de miembros");
+    expect(metadata.description).toContain(locale === "en" ? "Sign in or create" : "Inicia sesión o crea");
+  });
+  it("keeps legal navigation outside both authentication form states", () => {
+    const page = readFileSync(new URL("./page.tsx", import.meta.url), "utf8");
+    expect(page).toContain('href="https://corazonsalud.health/privacy/"');
+    expect(page).toContain('href="https://corazonsalud.health/terms/"');
+    for (const label of ["Privacy Policy", "Política de Privacidad", "Terms of Service", "Términos de Servicio"]) expect(page).toContain(label);
+    expect(page.indexOf('className="auth-legal"')).toBeGreaterThan(page.indexOf("<LillyAuthForm"));
+    const layout = readFileSync(new URL("../layout.tsx", import.meta.url), "utf8");
+    expect(layout).toContain("robots: { index: false, follow: false }");
+    expect(layout).toContain("lang={await getPortalLocale()}");
+  });
+});
