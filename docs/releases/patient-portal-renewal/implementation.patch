@@ -0,0 +1,46 @@
+"use server";
+import { revalidatePath } from "next/cache";
+import { lillyPatientRequest } from "@/lib/api/lilly";
+import { requirePortalOrigin } from "@/lib/auth/origin";
+import { getPortalLocale } from "@/lib/portal-locale";
+import { readOnlineRenewal } from "./renewal-data";
+
+const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+export async function renewalAction(_state: { message: string }, form: FormData) {
+  await requirePortalOrigin();
+  const locale = await getPortalLocale();
+  const t = (es: string, en: string) => locale === "en" ? en : es;
+  try {
+    const current = await readOnlineRenewal();
+    const operation = form.get("operation");
+    if (operation === "create") {
+      const key = form.get("idempotencyKey");
+      if (!current.membership || !current.eligible || typeof key !== "string" || !uuid.test(key))
+        return { message:t("La renovación aún no está disponible.", "Renewal is not available yet.") };
+      await lillyPatientRequest("renewal", { method:"POST",authenticated:true,
+        body:{ action:"CREATE",membershipId:current.membership.id,idempotencyKey:key } });
+    } else {
+      const intentId = form.get("intentId");
+      const intent = current.renewals.find(item => item.id === intentId);
+      if (!intent || ["CANCELLED","FULFILLED"].includes(intent.status))
+        return { message:t("Actualiza la página para consultar el estado actual.", "Refresh the page to see the current status.") };
+      if (operation === "cancel") {
+        await lillyPatientRequest("renewal", { method:"POST",authenticated:true,body:{action:"CANCEL",intentId:intent.id} });
+      } else if (operation === "invoice") {
+        if (!intent.agreementSatisfied) {
+          if (form.get("accepted") !== "yes") return { message:t("Lee y acepta el acuerdo antes de continuar.", "Read and accept the agreement before continuing.") };
+          await lillyPatientRequest("agreement", { method:"POST",authenticated:true,body:{intentId:intent.id,language:locale,accepted:true} });
+        }
+        const result = await lillyPatientRequest("invoice", { method:"POST",authenticated:true,body:{intentId:intent.id} });
+        if (result.status !== "INVOICE_CREATED") {
+          revalidatePath("/renovacion");
+          return { message:t("Estamos verificando la factura. No se emitirá una segunda factura durante la revisión.", "We're verifying your invoice. A second invoice will not be issued during review.") };
+        }
+      } else return { message:t("Acción no válida.", "Invalid action.") };
+    }
+    revalidatePath("/renovacion"); revalidatePath("/pagos"); revalidatePath("/membresia");
+    return { message:t("Solicitud actualizada. Consulta el estado abajo. Tu vigencia solo cambia después del pago verificado.", "Request updated. Check its status below. Your term changes only after verified payment.") };
+  } catch {
+    return { message:t("No pudimos completar la solicitud. Actualiza el estado antes de reintentar o contacta al equipo para revisar la factura. No se ha confirmado una extensión.", "We couldn't complete the request. Refresh its status before retrying or contact the team to review the invoice. No extension has been confirmed.") };
+  }
+}
