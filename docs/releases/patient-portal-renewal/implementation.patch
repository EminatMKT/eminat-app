+import {beforeEach,describe,expect,it,vi} from "vitest";
+const mocks=vi.hoisted(()=>({origin:vi.fn(),request:vi.fn(),read:vi.fn(),revalidate:vi.fn(),locale:"en"}));
+vi.mock("@/lib/auth/origin",()=>({requirePortalOrigin:mocks.origin}));
+vi.mock("@/lib/api/lilly",()=>({lillyPatientRequest:mocks.request}));
+vi.mock("@/lib/portal-locale",()=>({getPortalLocale:async()=>mocks.locale}));
+vi.mock("next/cache",()=>({revalidatePath:mocks.revalidate}));
+vi.mock("./renewal-data",()=>({readOnlineRenewal:mocks.read}));
+import {renewalAction} from "./renewal-action";
+const id="12345678-1234-4234-8234-123456789012";
+const key="23456789-2345-4345-8345-234567890123";
+function form(operation:string,fields:Record<string,string>={}) { const data=new FormData();data.set("operation",operation);for(const [k,v] of Object.entries(fields))data.set(k,v);return data; }
+beforeEach(()=>{vi.clearAllMocks();mocks.locale="en";mocks.request.mockResolvedValue({status:"INVOICE_CREATED"});
+  mocks.read.mockResolvedValue({membership:{id},eligible:true,renewals:[{id,status:"PAYMENT_PENDING",agreementSatisfied:true}]});});
+describe("Portal renewal server actions",()=>{
+  it("requires the Portal origin and uses only the authenticated membership",async()=>{
+    await renewalAction({message:""},form("create",{idempotencyKey:key,membershipId:"foreign"}));
+    expect(mocks.origin).toHaveBeenCalledOnce();expect(mocks.request).toHaveBeenCalledWith("renewal",{method:"POST",authenticated:true,body:{action:"CREATE",membershipId:id,idempotencyKey:key}});
+  });
+  it("does not invoice someone else's intent",async()=>{
+    await renewalAction({message:""},form("invoice",{intentId:key}));expect(mocks.request).not.toHaveBeenCalled();
+  });
+  it("reuses existing consent without fabricating a second acceptance",async()=>{
+    await renewalAction({message:""},form("invoice",{intentId:id}));
+    expect(mocks.request).toHaveBeenCalledOnce();expect(mocks.request.mock.calls[0][0]).toBe("invoice");
+  });
+  it("requires explicit acceptance when the server says reacceptance is required",async()=>{
+    mocks.read.mockResolvedValue({membership:{id},eligible:true,renewals:[{id,status:"PAYMENT_PENDING",agreementSatisfied:false}]});
+    await renewalAction({message:""},form("invoice",{intentId:id,agreementSatisfied:"true"}));expect(mocks.request).not.toHaveBeenCalled();
+    await renewalAction({message:""},form("invoice",{intentId:id,accepted:"yes"}));
+    expect(mocks.request.mock.calls.map(call=>call[0])).toEqual(["agreement","invoice"]);
+  });
+  it("requests cancellation through the supported API, never a QBO write",async()=>{
+    await renewalAction({message:""},form("cancel",{intentId:id}));
+    expect(mocks.request).toHaveBeenCalledWith("renewal",{method:"POST",authenticated:true,body:{action:"CANCEL",intentId:id}});
+  });
+  it("does not claim a renewal or payment succeeded after an uncertain invoice response",async()=>{
+    mocks.request.mockResolvedValue({status:"PENDING_RECONCILIATION"});
+    const result=await renewalAction({message:""},form("invoice",{intentId:id}));
+    expect(result.message).toContain("second invoice will not be issued");
+  });
+  it("provides Spanish feedback without English fallback",async()=>{
+    mocks.locale="es";mocks.request.mockRejectedValue(new Error("private provider details"));
+    const result=await renewalAction({message:""},form("invoice",{intentId:id}));
+    expect(result.message).toContain("No pudimos");expect(result.message).not.toContain("private provider");
+  });
+});
