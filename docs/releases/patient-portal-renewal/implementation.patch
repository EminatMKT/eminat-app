@@ -0,0 +1,33 @@
+"use client";
+import { useActionState, useState } from "react";
+import { renewalAction } from "./renewal-action";
+import type { PortalLocale } from "@/lib/portal-locale";
+
+export function RenewalControls({locale,intentId,idempotencyKey,agreementSatisfied,invoiceLocked,canRecover,create}: {
+  locale:PortalLocale;intentId?:string;idempotencyKey?:string;agreementSatisfied?:boolean;invoiceLocked?:boolean;canRecover?:boolean;create?:boolean;
+}) {
+  const [state,action,pending] = useActionState(renewalAction,{message:""});
+  const [accepted,setAccepted] = useState(false);
+  const t = (es:string,en:string) => locale === "en" ? en : es;
+  return <form action={action} className="agreement-acceptance">
+    {intentId && <input type="hidden" name="intentId" value={intentId}/>}
+    {idempotencyKey && <input type="hidden" name="idempotencyKey" value={idempotencyKey}/>}
+    {create ? <button className="button button-primary" type="submit" name="operation" value="create" disabled={pending}>
+      {t("Preparar renovación", "Prepare renewal")}</button> : <>
+      {!invoiceLocked && <>
+        {agreementSatisfied ? <p className="inline-note">{t("Tu aceptación vigente del acuerdo v5 cubre esta renovación sin cambios de plan.", "Your current v5 agreement acceptance covers this renewal with the same plan.")}</p> : <>
+          <a href={`/acuerdo/${locale}`} target="_blank" rel="noopener noreferrer">{t("Ver Acuerdo de Membresía", "View Membership Agreement")}</a>
+          <label className="agreement-checkbox"><input type="checkbox" name="accepted" value="yes" checked={accepted} onChange={event => setAccepted(event.target.checked)}/>
+            <span>{t("He leído y acepto el Acuerdo de Membresía del Paciente y sus términos y condiciones.", "I have read and accept the Patient Membership Agreement and its terms and conditions.")}</span></label>
+        </>}
+        <button className="button button-primary" type="submit" name="operation" value="invoice" disabled={pending || (!agreementSatisfied && !accepted)}>
+          {pending ? t("Preparando factura…", "Preparing invoice…") : t("Emitir factura de renovación", "Issue renewal invoice")}</button>
+      </>}
+      {invoiceLocked && canRecover && <button className="button button-primary" type="submit" name="operation" value="invoice" disabled={pending}>
+        {t("Consultar factura en revisión", "Check invoice under review")}</button>}
+      <button className="button button-secondary" type="submit" name="operation" value="cancel" disabled={pending}>
+        {invoiceLocked ? t("Solicitar cancelación y revisión de factura", "Request cancellation and invoice review") : t("Cancelar renovación", "Cancel renewal")}</button>
+    </>}
+    {state.message && <p role="status">{state.message}</p>}
+  </form>;
+}
