+      <p className="inline-note">{t("La renovación conserva tu código, titular y familiares cubiertos. No modifica la vigencia mientras el pago esté pendiente.","Renewal keeps your member code, primary member, and covered family. Pending payment does not change your current term.")}</p>
+      {!pending && offset===0 && (data.eligible ? <RenewalControls locale={locale} create idempotencyKey={randomUUID()}/> : <p>{t("La renovación estará disponible desde","Renewal will be available starting")} {data.eligibleFrom ? formatDate(data.eligibleFrom,locale) : "—"}.</p>)}
+    </Card>{data.renewals.map(item => {
+      const open = !["FULFILLED","CANCELLED","CANCELLATION_REQUESTED"].includes(item.status);
+      const url = item.qbo?.qbo_hosted_payment_url;
+      const pay = open && item.qbo?.qbo_invoice_status === "OPEN" && url && /^https:\/\/connect\.intuit\.com\/t\/[^\s]+$/.test(url);
+      return <Card key={item.id}><SectionTitle title={statuses[item.status] ?? t("En revisión","Under review")}/>
+        <p>{t("Importe de renovación","Renewal amount")}: {new Intl.NumberFormat(locale === "en" ? "en-US" : "es-US",{style:"currency",currency:"USD"}).format(item.amount_cents/100)}</p>
+        <p>{t("Factura","Invoice")}: {item.qbo?.qbo_invoice_number ?? t("Sin emitir","Not issued")}</p>
+        <p>{t("Conciliación","Reconciliation")}: {item.renewed_at ? t("Pago verificado","Payment verified") : t("Sin pago verificado","No verified payment")}</p>
+        {item.status === "FULFILLED" && item.renewed_at && item.renewal_starts_at && item.renewal_expires_at &&
+          <p>{t("Período renovado","Renewed term")}: {formatDate(item.renewal_starts_at,locale)} — {formatDate(item.renewal_expires_at,locale)}</p>}
+        {pay && <a className="button button-primary" href={url} target="_blank" rel="noopener noreferrer">{t("Pagar renovación de forma segura","Pay renewal securely")}</a>}
+        {open && <RenewalControls locale={locale} intentId={item.id} agreementSatisfied={item.agreementSatisfied} invoiceLocked={Boolean(item.invoiceJobState || item.qbo?.qbo_invoice_number)} canRecover={Boolean(item.invoiceJobState && item.invoiceJobState !== "LINKED" && !item.qbo?.qbo_invoice_number)}/>}
+      </Card>;
+    })}<nav aria-label={t("Historial de renovaciones","Renewal history")}>
+      {offset>0 && <Link className="text-action" href={`/renovacion?offset=${Math.max(0,offset-25)}`}>{t("Renovaciones más recientes","Newer renewals")} →</Link>}
+      {data.nextOffset !== null && <Link className="text-action" href={`/renovacion?offset=${data.nextOffset}`}>{t("Renovaciones anteriores","Older renewals")} →</Link>}
+    </nav><Link className="text-action" href="/membresia">{t("Volver a mi membresía","Back to my membership")} →</Link></>;
+}
