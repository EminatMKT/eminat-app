+++ b/tests/fixtures/renewal-api.mjs
@@ -0,0 +1,38 @@
+// Loopback-only synthetic Patient API for browser regression. Never deployed.
+import {createServer} from 'node:http';
+if (process.env.NODE_ENV === 'production') throw new Error('SYNTHETIC_API_FORBIDDEN_IN_PRODUCTION');
+const id='12345678-1234-4234-8234-123456789012';
+const intentId='23456789-2345-4345-8345-234567890123';
+const member={id,code:'QA-LOCAL-RENEWAL',plan:'ESSENTIAL',membership_type:'FAMILY',duration:'MONTHLY',status:'ACTIVE',issued_at:'2026-09-05',expires_at:'2026-11-05'};
+let scenario='eligible',intents=[],invoiceCount=0;
+const initialIntent=()=>({id:intentId,status:'PAYMENT_UNAVAILABLE',amount_cents:9999,duration:'MONTHLY',created_at:'2026-10-26T00:00:00Z',renewed_at:null,renewal_starts_at:null,renewal_expires_at:null,agreementSatisfied:true,invoiceJobState:null,qbo:null});
+const server=createServer(async(req,res)=>{
+  const url=new URL(req.url,'http://127.0.0.1');
+  let body={};if(req.method==='POST'){let text='';for await(const chunk of req)text+=chunk;if(text)body=JSON.parse(text);}
+  const send=(data,status=200)=>{res.writeHead(status,{'Content-Type':'application/json','Cache-Control':'no-store'});res.end(JSON.stringify(data));};
+  if(url.pathname==='/__scenario'){
+    if(req.method==='POST'){scenario=body.scenario;intents=[];invoiceCount=0;
+      if(['pending','paid','agreement','cancelled'].includes(scenario))intents=[initialIntent()];
+      if(scenario==='agreement')intents[0].agreementSatisfied=false;
+      if(scenario==='cancelled')intents[0].status='CANCELLED';
+      if(scenario==='paid')Object.assign(intents[0],{status:'FULFILLED',renewed_at:'2026-10-26T00:00:00Z',renewal_starts_at:'2026-11-05',renewal_expires_at:'2026-12-05'});
+    }return send({scenario,invoiceCount,intents});
+  }
+  if(!req.headers.authorization?.startsWith('Patient cspt_'))return send({code:'AUTHENTICATION_REQUIRED'},401);
+  const resource=url.pathname.split('/').at(-1);
+  if(resource==='session')return send({data:{authId:id,email:'local-renewal@example.invalid',contactId:id}});
+  if(resource==='profile')return send({data:{id,first_name:'LOCAL QA',last_name:'Renewal',email:'local-renewal@example.invalid',phone:'555-0100',address:{street:'Synthetic only',line2:'',city:'Miami',state:'FL',postalCode:'33101',country:'US'},created_at:'2026-09-05T00:00:00Z'}});
+  if(resource==='renewal'){
+    if(req.method==='POST'&&body.action==='CREATE'&&!intents.some(i=>!['FULFILLED','CANCELLED'].includes(i.status)))intents.unshift(initialIntent());
+    if(req.method==='POST'&&body.action==='CANCEL')intents[0].status=intents[0].qbo?'CANCELLATION_REQUESTED':'CANCELLED';
+    return send({data:{membership:{...member,expires_at:scenario==='paid'?'2026-12-05':member.expires_at},eligible:scenario!=='early',eligibleFrom:'2026-10-06',hasPending:intents.some(i=>!['FULFILLED','CANCELLED'].includes(i.status)),nextOffset:null,renewals:intents}});
+  }
+  if(resource==='agreement'){intents[0].agreementSatisfied=true;return send({status:'ACCEPTED',version:'v5'});}
+  if(resource==='invoice'){
+    if(!intents[0].qbo){invoiceCount++;Object.assign(intents[0],{status:'PAYMENT_PENDING',invoiceJobState:'LINKED',qbo:{qbo_invoice_number:'LOCAL-NOT-REAL',qbo_hosted_payment_url:'https://connect.intuit.com/t/local-test-not-real',qbo_invoice_status:'OPEN',qbo_payment_status:'UNPAID',verification_state:'PAYMENT_PENDING'}});}
+    return send({status:'INVOICE_CREATED'});
+  }
+  if(resource==='membership')return send({data:{...member,qa_synthetic:true}});
+  return send({data:[]});
+});
+server.listen(Number(process.env.RENEWAL_FIXTURE_PORT||3192),'127.0.0.1',()=>process.stdout.write('Loopback synthetic renewal API ready\n'));
