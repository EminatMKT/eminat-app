+import {test,expect} from '@playwright/test';
+const host='http://127.0.0.1:3191';
+test.beforeEach(async({context,request})=>{
+  await request.post('http://127.0.0.1:3192/__scenario',{data:{scenario:'eligible'}});
+  await context.addCookies([{name:'__Host-corazon_patient',value:`cspt_${'Q'.repeat(48)}.${Date.now()+3600000}`,url:'https://127.0.0.1:3191/',secure:true,httpOnly:true,sameSite:'Lax'},
+    {name:'cs_locale',value:'en',url:host}]);
+});
+test('one-month Family renewal prepares an invoice without changing active coverage or navigating to payment',async({page,request})=>{
+  const external:string[]=[];page.on('request',req=>{if(/^https?:/.test(req.url())&&new URL(req.url()).hostname!=='127.0.0.1')external.push(req.url());});
+  await page.goto('/renovacion');
+  await expect(page.getByRole('heading',{name:'Current membership term'})).toBeVisible();
+  await page.getByRole('button',{name:'Prepare renewal',exact:true}).click();
+  await expect(page.getByText('Renewal amount: $99.99')).toBeVisible();
+  await expect(page.getByText(/current v5 agreement acceptance/)).toBeVisible();
+  await expect(page.getByRole('checkbox')).toHaveCount(0);
+  await page.getByRole('button',{name:'Issue renewal invoice',exact:true}).click();
+  await expect(page.getByRole('link',{name:'Pay renewal securely'})).toHaveAttribute('href','https://connect.intuit.com/t/local-test-not-real');
+  await expect(page.getByText('No verified payment',{exact:false})).toBeVisible();
+  await expect(page.getByText('Renewed term:',{exact:false})).toHaveCount(0);
+  await page.reload();
+  expect((await(await request.get('http://127.0.0.1:3192/__scenario')).json()).invoiceCount).toBe(1);
+  expect(external).toEqual([]);
+});
+test('requires explicit reacceptance when evidence is missing',async({page,request})=>{
+  await request.post('http://127.0.0.1:3192/__scenario',{data:{scenario:'agreement'}});await page.goto('/renovacion');
+  const issue=page.getByRole('button',{name:'Issue renewal invoice',exact:true});await expect(issue).toBeDisabled();
+  await page.getByRole('checkbox').check();await expect(issue).toBeEnabled();
