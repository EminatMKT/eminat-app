+    const pending = data.hasPending;
+    const statuses:Record<string,string> = {
+      PAYMENT_UNAVAILABLE:t("Pendiente de factura","Awaiting invoice"), PAYMENT_PENDING:t("Pendiente de pago verificado","Awaiting verified payment"),
