@@ -0,0 +1,20 @@
+import "server-only";
+import { lillyPatientRequest } from "@/lib/api/lilly";
+
+export type OnlineRenewal = { id:string;status:string;amount_cents:number;duration:string;created_at:string;
+  renewed_at:string|null;renewal_starts_at:string|null;renewal_expires_at:string|null;
+  agreementSatisfied:boolean;invoiceJobState:string|null;
+  qbo:{qbo_invoice_number:string|null;qbo_hosted_payment_url:string|null;qbo_invoice_status:string;
+    qbo_payment_status:string;verification_state:string}|null };
+export type OnlineRenewalData = { membership:{id:string;code:string;plan:string;membership_type:string;
+  duration:string;status:string;issued_at:string;expires_at:string}|null;eligible:boolean;eligibleFrom:string|null;hasPending:boolean;nextOffset:number|null;renewals:OnlineRenewal[] };
+export async function readOnlineRenewal(offset=0): Promise<OnlineRenewalData> {
+  if (!Number.isSafeInteger(offset) || offset<0 || offset>100000) throw new Error("INVALID_RENEWAL_PAGE");
+  const response = await lillyPatientRequest("renewal", {authenticated:true,offset});
+  const data = response.data as OnlineRenewalData | undefined;
+  if (!data || typeof data.eligible !== "boolean" || typeof data.hasPending !== "boolean" ||
+      (data.nextOffset !== null && (!Number.isSafeInteger(data.nextOffset) || data.nextOffset <= offset || data.nextOffset>100000)) || !Array.isArray(data.renewals) ||
+      data.renewals.some(item => typeof item.id !== "string" || !Number.isSafeInteger(item.amount_cents) || item.amount_cents <= 0))
+    throw new Error("RENEWAL_UNAVAILABLE");
+  return data;
+}
