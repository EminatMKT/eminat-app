+import {beforeEach,describe,expect,it,vi} from 'vitest';
+import {lillyRequest} from '@/lib/api/adapters/lilly';
+const fetchMock=vi.fn();
+beforeEach(()=>{vi.clearAllMocks();vi.stubGlobal('fetch',fetchMock);fetchMock.mockResolvedValue(new Response(JSON.stringify({data:{renewals:[]}}),{status:200}));});
+describe('renewal history transport',()=>{
+  it('adds only the encoded history cursor on the existing authenticated API boundary',async()=>{
+    const transport={kind:'patient-cookie' as const,read:vi.fn(),clear:vi.fn(),establish:vi.fn(),authorize:vi.fn(async(headers:Headers)=>{headers.set('Authorization','Patient synthetic-fixture-only');return true;})};
+    await lillyRequest('https://app.stratixsolutions.us/api/patient/v1/','renewal',{offset:125,transport});
+    expect(String(fetchMock.mock.calls[0][0])).toBe('https://app.stratixsolutions.us/api/patient/v1/renewal?offset=125');
+    expect(fetchMock.mock.calls[0][1]).toMatchObject({redirect:'error',cache:'no-store'});
+    expect(transport.authorize).toHaveBeenCalledOnce();
+  });
+  it.each([-1,100001,NaN,1.5])('rejects invalid history cursors without network access: %s',async offset=>{
+    await expect(lillyRequest('http://127.0.0.1/api/','renewal',{offset})).rejects.toMatchObject({code:'validation_failed'});expect(fetchMock).not.toHaveBeenCalled();
+  });
+  it('cannot apply history paging to invoice writes or other resources',async()=>{
+    await expect(lillyRequest('http://127.0.0.1/api/','invoice',{offset:25,method:'POST'})).rejects.toMatchObject({code:'validation_failed'});
+    await expect(lillyRequest('http://127.0.0.1/api/','renewal',{offset:25,method:'POST'})).rejects.toMatchObject({code:'validation_failed'});expect(fetchMock).not.toHaveBeenCalled();
+  });
+});
