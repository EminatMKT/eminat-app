# ⚠️ Credenciales POR ENTORNO. TRES bases, una por tier:
#   • local        → Supabase local (supabase start, 127.0.0.1). Va en tu .env.local.
#   • development  → Supabase dev remoto. Vive en Vercel (scope Preview).
#   • production   → Supabase prod. Vive en Vercel (scope Production).
# Este template es para tu .env.local (tier local). Las vars de development y
# production NO van en archivos del repo: viven en el dashboard de Vercel.
# env.client.ts rompe el build si un tier ≠ production apunta al ref de prod.

# ── Supabase (cliente) — credenciales de tu Supabase LOCAL ─────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Supabase + Resend (solo servidor) ─────────────────────────
SUPABASE_SECRET_KEY=sb_secret_...
RESEND_API_KEY=re_...
# URL pública de Tasks en este entorno (Preview debe usar su propio dominio).
TASKS_PUBLIC_URL=https://example-preview.vercel.app/tasks
# Opcional: remitente verificado de Resend, equivalente a Meet.
TASK_NOTIFY_FROM_EMAIL=LILLY <notificaciones@stratixsolutions.us>
# Secreto del procesador del outbox (Vercel cron o invocación manual en Preview).
CRON_SECRET=replace-with-long-random-value

# ANNIE Sales: server-only. Use an approved active user mapping; ANNIE decides
# the current role and record scope. Keep rollout disabled until both apps share
# the same private signing key and the ANNIE identity endpoint passes live QA.
ANNIE_SALES_API_ORIGIN=https://annie.stratixsolutions.us
ANNIE_SALES_ENABLED=false
# ANNIE_SALES_TRUST_KEY=<base64url random key, at least 32 decoded bytes; never commit>
# Lead writes are disabled unless exactly one mode is true. Keep commercial mode
# false until the paired ANNIE/LILLY release and controlled QA have passed.
ANNIE_SALES_QA_WRITE_ENABLED=false
ANNIE_SALES_COMMERCIAL_LEAD_WRITE_ENABLED=false
ANNIE_SALES_QA_CONTACT_WRITE_ENABLED=false
ANNIE_SALES_COMMERCIAL_CONTACT_WRITE_ENABLED=false
ANNIE_SALES_QA_ACCOUNT_WRITE_ENABLED=false
ANNIE_SALES_COMMERCIAL_ACCOUNT_WRITE_ENABLED=false
ANNIE_SALES_QA_OPPORTUNITY_WRITE_ENABLED=false
ANNIE_SALES_COMMERCIAL_OPPORTUNITY_WRITE_ENABLED=false

# ── Tier del entorno (NEXT_PUBLIC_: lo lee el cliente para isProdDb/badge) ──
# local | development | production
NEXT_PUBLIC_APP_ENV=local
